+// STRATA_DUAL_Q8=1: retain the routed precise and shared fast-math byte images.
+// CUDA only: explicit FTZ operations match native_mmvq.cu; this TU stays precise.
+#if !defined(STRATA_USE_HIP)
+__device__ __forceinline__ float dual_fast_abs(float x){float y;asm("abs.ftz.f32 %0, %1;":"=f"(y):"f"(x));return y;}
+__device__ __forceinline__ float dual_fast_max(float a,float b){float y;asm("max.ftz.f32 %0, %1, %2;":"=f"(y):"f"(a),"f"(b));return y;}
+__device__ __forceinline__ float dual_fast_add(float a,float b){float y;asm("add.rn.ftz.f32 %0, %1, %2;":"=f"(y):"f"(a),"f"(b));return y;}
+__device__ __forceinline__ float dual_fast_div(float a,float b){float y;asm("div.approx.ftz.f32 %0, %1, %2;":"=f"(y):"f"(a),"f"(b));return y;}
+__device__ __forceinline__ float dual_fast_round(float a){float h=copysignf(.5f,a),y,z;asm("add.rz.ftz.f32 %0, %1, %2;":"=f"(y):"f"(a),"f"(h));asm("cvt.rzi.f32.f32 %0, %1;":"=f"(z):"f"(y));return z;}
+__global__ __launch_bounds__(256,1) void dual_q8_1_kernel(const float*x,block_q8_1*routed,block_q8_1*shared,int n){
+ int i=blockIdx.x*256+threadIdx.x;if(i>=n)return;
+ float xi=x[i],am=fabsf(xi),af=dual_fast_abs(xi),sum=xi,sf=xi;
+ #pragma unroll
+ for(int o=16;o;o>>=1){
+  am=fmaxf(am,__shfl_xor_sync(0xffffffffu,am,o));
+  af=dual_fast_max(af,__shfl_xor_sync(0xffffffffu,af,o));
+  sum=__fadd_rn(sum,__shfl_xor_sync(0xffffffffu,sum,o));
+  sf=dual_fast_add(sf,__shfl_xor_sync(0xffffffffu,sf,o));
+ }
+ float d=q8_1_finite(__fdiv_rn(am,127.f));
+ float df=q8_1_finite(dual_fast_div(af,127.f));
+ signed char qr=q8_1_quant(xi,d,am),qf=0;
+ if(af!=0.f){float q=dual_fast_round(dual_fast_div(xi,df));qf=(signed char)(q>127.f?127.f:q< -127.f?-127.f:q);}
+ routed[i/32].qs[i%32]=qr;shared[i/32].qs[i%32]=qf;
+ if(i%32==0){routed[i/32].ds=q8_1_ds(d,sum);shared[i/32].ds=q8_1_ds(df,sf);}
+}
+#endif

+    // Opt-in, exact CPU-only IQ3_S expansion. Prepare before workers can read the source.
+    // A static extra allocation, never a miss cache: native blobs and GPU transfers stay intact.
+    if (const char* setting = std::getenv("STRATA_CPU_IQ3S_CACHE_GIB")) {
+        const auto start = std::chrono::steady_clock::now();
+        uint64_t gib = 0;
+        bool valid = *setting != '\0';
+        for (const char* p = setting; valid && *p; ++p) {
+            valid = *p >= '0' && *p <= '9' && gib <= (UINT64_MAX / (1ull << 30) - 9) / 10;
+            if (valid) gib = gib * 10 + uint64_t(*p - '0');
+        }
+        detail::HostMemory hm;
+        std::string reason;
+        if (!valid) reason = "budget must be a nonnegative integer GiB";
+        else if (!gib) reason = "disabled";
+        else if (!shared_arena_file.empty()) reason = "shared expert arenas are not supported";
+        else if (!detail::host_available_memory(hm)) reason = "host RAM/commit information unavailable";
+        else compact_gu_.prepare(base_, want, lay, gib << 30, hm.available, hm.commit, 16ull << 30, reason);
+        const double seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+        std::fprintf(stderr, "strata generate: exact IQ3_S CPU cache: %s; %llu bytes, %.3f s; 16 GiB RAM/commit reserve\n",
+                     reason.c_str(), (unsigned long long) compact_gu_.bytes(), seconds);
+    }
     record_inputs(path, gguf_, lay, from_gguf);
     return true;
 }
 

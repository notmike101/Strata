index 00000000..d649fba2
--- /dev/null
+++ b/src/kernels/cpu/iq3s_cache_test.cpp
@@ -0,0 +1,82 @@
+#include "strata/kernels/cpu/iq3s_cache.hpp"
+#define main original_parity_main
+#include "iq_avx2_parity.cpp"
+#undef main
+#include "strata/kernels/cpu/pool.hpp"
+#include <stdexcept>
+#define GGML_COMMON_DECL_CPP
+#include "ggml-common.h"
+
+static void require(bool ok, const char* msg) { if (!ok) throw std::runtime_error(msg); }
+int main() {
+    ggml_cpu_init();
+    if (!cpu::cpu_avx2_ok() || cpu::cpu_avx512_ok() || std::getenv("STRATA_NO_IQ256")) return 77;
+    try {
+        cpu::NativeFmt f; std::string why;
+        require(cpu::native_fmt(21,20,kH,kFF,f,why), "native geometry");
+        cpu::ExpertLayout lay; lay.native=true; lay.n_layers=1; lay.n_expert=3;
+        lay.fmt={f}; lay.offset={0}; lay.bytes={f.bytes}; lay.total=f.bytes*3; lay.max_blob=f.bytes;
+        std::vector<uint8_t> blobs(lay.total);
+        for(int e=0;e<3;++e) { uint64_t seed=301+e; fill_blob(blobs.data()+e*f.bytes,f,seed); }
+        const uint64_t need=3*2*kFF*(kH/256)*sizeof(cpu::Iq3sCompactBlock), reserve=16ull<<30;
+        cpu::Iq3sCache cache;
+        require(!cache.prepare(blobs.data(),blobs.size(),lay,0,need+reserve,64ull<<30,reserve,why), "disabled");
+        require(cache.get(0,0)==nullptr && cache.bytes()==0,"disabled storage");
+        require(!cache.prepare(blobs.data(),blobs.size(),lay,need-1,need+reserve,64ull<<30,reserve,why),"budget refusal");
+        require(!cache.prepare(blobs.data(),blobs.size(),lay,need,need+reserve-1,64ull<<30,reserve,why),"RAM refusal");
+        require(!cache.prepare(blobs.data(),blobs.size(),lay,need,need+reserve,need+reserve-1,reserve,why),"commit refusal");
+        require(!cache.prepare(blobs.data(),blobs.size(),lay,need,need+reserve,~0ull,reserve,why),"unknown commit refusal");
+        require(cache.prepare(blobs.data(),blobs.size(),lay,need,need+reserve,64ull<<30,reserve,why),"valid exact cache must load");
+        require(cache.bytes()==need && cache.get(0,0) && cache.get(0,2),"cache size/endpoints");
+        require(!cache.get(-1,0)&&!cache.get(1,0)&&!cache.get(0,-1)&&!cache.get(0,3),"lookup bounds");
+        cache.clear(); require(cache.bytes()==0 && !cache.get(0,0),"clear releases");
+        require(cache.prepare(blobs.data(),blobs.size(),lay,need,need+reserve,64ull<<30,reserve,why),"reopen");
+        auto bad=lay; bad.offset[0]=~0ull-1;
+        require(!cache.prepare(blobs.data(),blobs.size(),bad,need,need+reserve,64ull<<30,reserve,why),"offset overflow");
+        require(!cache.get(0,0)&&cache.bytes()==0,"failure clears old storage");
+        bad=lay; bad.fmt[0].n_embd=1;
+        require(!cache.prepare(blobs.data(),blobs.size(),bad,need,need+reserve,64ull<<30,reserve,why),"invalid shape");
+        bad=lay; bad.n_expert=INT64_MAX;
+        require(!cache.prepare(blobs.data(),blobs.size(),bad,need,need+reserve,64ull<<30,reserve,why),"size overflow");
+        bad=lay; bad.fmt[0].gu_type=18;
+        require(!cache.prepare(blobs.data(),blobs.size(),bad,need,need+reserve,64ull<<30,reserve,why),"unsupported format");
+        require(cache.prepare(blobs.data(),blobs.size(),lay,need,need+reserve,64ull<<30,reserve,why),"parity prepare");
+        cpu::Iq3sCache other;
+        require(other.prepare(blobs.data(),blobs.size(),lay,need,need+reserve,64ull<<30,reserve,why),"second owner");
+        require(other.get(0,0)!=cache.get(0,0),"independent owners");
+        other.clear(); require(cache.get(0,0)!=nullptr,"independent lifetime");
+        // Direct rows additionally stress sign-on-activation at -128, signed/zero scales,
+        // and partial row ranges without relying on the pool's dispatch threshold.
+        Acts edge(f,1701);
+        for(int t=0;t<kMaxT;++t) for(int b=0;b<kH/256;++b) {
+            auto& q=reinterpret_cast<block_q8_K*>(edge.gu[t].data())[b];
+            q.d=b%3==0?0.f:((b%2)?-.001f:.001f);
+            for(int j=0;j<256;++j) q.qs[j]=((j+t)%3==0)?-128:(((j+t)%3==1)?127:0);
+        }
+        for(int nt=1;nt<=8;++nt) {
+            std::vector<float> a(nt*kFF,-99),b(a); float* ap[8];float* bp[8];
+            for(int t=0;t<nt;++t) { ap[t]=a.data()+t*kFF;bp[t]=b.data()+t*kFF; }
+            cpu::iq256_gu_rows_v(cpu::kIq256Gather,21,blobs.data(),f.gu_row,f.up_off,kH,edge.gup,nt,ap,7,kFF-3);
+            cpu::iq3s_compact_gu(cache.get(0,0),kH/256,edge.gup,nt,bp,kFF,7,kFF-3);
+            require(rows_differ(a.data(),b.data(),a.size())==0,"extreme activation/range parity");
+        }
+        Acts act(f,1601); cpu::ExpertPool pool(9,false,true,cpu::PoolAffinity::All,30);
+        int cases=0;
+        for(int nt=1;nt<=8;++nt) for(int nj:{1,3}) {
+            std::vector<float> out(nj*nt*kH), reference;
+            std::vector<cpu::ExpertJobMulti> jobs(nj);
+            for(int j=0;j<nj;++j) {
+                jobs[j].blob=blobs.data()+j*f.bytes; jobs[j].nt=nt;
+                for(int t=0;t<nt;++t) { jobs[j].nact[t]=act.gup[t]; jobs[j].out[t]=out.data()+(j*nt+t)*kH; }
+            }
+            pool.run_split_multi_native(f,jobs.data(),nj); reference=out;
+            for(int j=0;j<nj;++j) jobs[j].compact_gu=cache.get(0,j);
+            pool.run_split_multi_native(f,jobs.data(),nj);
+            require(rows_differ(reference.data(),out.data(),out.size())==0,"complete pool bitwise parity");
+            for(float x:out) require(std::isfinite(x),"finite output");
+            ++cases;
+        }
+        std::printf("C020 cache memory/bounds/lifecycle PASS; %d complete-pool parity cases PASS\n",cases); return 0;
+    } catch(const std::exception& e) { std::fprintf(stderr,"C020 FAIL: %s\n",e.what()); return 1; }
+}

diff --git a/include/strata/kernels/cpu/iq3s_cache.hpp b/include/strata/kernels/cpu/iq3s_cache.hpp
new file mode 100644
index 00000000..1aa201b7
--- /dev/null
+++ b/include/strata/kernels/cpu/iq3s_cache.hpp
@@ -0,0 +1,97 @@
+#pragma once
+
+#include "strata/kernels/cpu/expert_layout.hpp"
+#include <limits>
+#include <memory>
+#include <cstdlib>
+
+namespace strata::kernels::cpu {
+
+// Exact IQ3_S codebook entries, signs, subscales and original fp16 scale.
+// This is a CPU representation, never a new model quant or a GPU tensor.
+struct Iq3sCompactBlock {
+    uint8_t weights[128];
+    uint8_t scales[8];
+    uint16_t d;
+};
+static_assert(sizeof(Iq3sCompactBlock) == 138);
+
+// AVX2 translation unit: callers must check cpu_avx2_ok first.
+void iq3s_compact_expand(const uint8_t* src, Iq3sCompactBlock* dst, size_t blocks);
+void iq3s_compact_gu(const Iq3sCompactBlock* src, int nb, const void* const* act, int nt,
+                     float* const* out, int rows, int r0, int r1);
+
+// Owned by one source, immutable after prepare, no request-time allocation.
+// As with its native arena, clear/destruction requires all source users stopped.
+class Iq3sCache {
+public:
+    bool prepare(const uint8_t* base, uint64_t base_bytes, const ExpertLayout& lay,
+                 uint64_t budget, uint64_t available, uint64_t commit, uint64_t reserve,
+                 std::string& why) {
+        clear();
+        if (!budget) { why = "disabled"; return false; }
+        if (commit == ~uint64_t{0}) { why = "commit headroom unavailable"; return false; }
+        if (!cpu_avx2_ok() || cpu_avx512_ok() || std::getenv("STRATA_NO_IQ256")) {
+            why = "requires the native AVX2 IQ path"; return false;
+        }
+        if (!base || !lay.native || lay.n_layers <= 0 || lay.n_expert <= 0 ||
+            uint64_t(lay.n_layers) != lay.fmt.size() || lay.fmt.size() != lay.offset.size() ||
+            lay.fmt.size() != lay.bytes.size() || lay.total > base_bytes) {
+            why = "invalid native layout"; return false;
+        }
+        uint64_t count = 0;
+        const uint64_t max_blocks = std::numeric_limits<size_t>::max() / sizeof(Iq3sCompactBlock);
+        try {
+            std::vector<uint64_t> offsets(lay.fmt.size(), ~uint64_t{0}), strides(lay.fmt.size(), 0);
+            for (size_t l = 0; l < lay.fmt.size(); ++l) {
+                const auto& f = lay.fmt[l];
+                if (f.gu_type != 21) continue;
+                NativeFmt expected; std::string error;
+                // Validate before native_fmt's row-byte arithmetic; the pool has bounded geometry.
+                if (f.n_embd <= 0 || f.n_embd > H || f.n_embd % 256 || f.n_ff <= 0 || f.n_ff > FF ||
+                    !native_fmt(21, f.d_type, f.n_embd, f.n_ff, expected, error) ||
+                    f.gu_row != expected.gu_row || f.up_off != expected.up_off ||
+                    f.down_off != expected.down_off || f.bytes != expected.bytes ||
+                    lay.bytes[l] != f.bytes || lay.offset[l] > base_bytes || !f.bytes ||
+                    uint64_t(lay.n_expert) > (base_bytes - lay.offset[l]) / f.bytes) {
+                    why = "unsupported or out-of-bounds IQ3_S geometry"; return false;
+                }
+                const uint64_t stride = 2 * uint64_t(f.n_ff) * uint64_t(f.n_embd / 256);
+                if (uint64_t(lay.n_expert) > (max_blocks - count) / stride) {
+                    why = "compact cache size overflow"; return false;
+                }
+                offsets[l] = count; strides[l] = stride;
+                count += stride * uint64_t(lay.n_expert);
+            }
+            const uint64_t need = count * sizeof(Iq3sCompactBlock);
+            if (!need || need > budget || available < reserve || need > available - reserve ||
+                commit < reserve || need > commit - reserve) {
+                why = "no supported layers or insufficient budget/RAM/commit headroom"; return false;
+            }
+            // Allocate into a temporary owner: failure never publishes a partial cache.
+            auto data = std::unique_ptr<Iq3sCompactBlock[]>(new Iq3sCompactBlock[size_t(count)]);
+            for (size_t l = 0; l < offsets.size(); ++l) if (strides[l])
+                for (int64_t e = 0; e < lay.n_expert; ++e)
+                    iq3s_compact_expand(base + lay.offset[l] + uint64_t(e) * lay.bytes[l],
+                                        data.get() + offsets[l] + uint64_t(e) * strides[l], size_t(strides[l]));
+            data_ = std::move(data); offsets_ = std::move(offsets); strides_ = std::move(strides);
+            experts_ = lay.n_expert; bytes_ = need; why = "ready"; return true;
+        } catch (const std::exception& e) {
+            why = std::string("compact allocation/expansion failed: ") + e.what(); return false;
+        }
+    }
+    const Iq3sCompactBlock* get(int64_t layer, int64_t expert) const {
+        if (!data_ || layer < 0 || uint64_t(layer) >= strides_.size() || !strides_[size_t(layer)] ||
+            expert < 0 || expert >= experts_) return nullptr;
+        return data_.get() + offsets_[size_t(layer)] + uint64_t(expert) * strides_[size_t(layer)];
+    }
+    uint64_t bytes() const { return bytes_; }
+    void clear() { data_.reset(); offsets_.clear(); strides_.clear(); bytes_ = 0; experts_ = 0; }
+private:
+    std::unique_ptr<Iq3sCompactBlock[]> data_;
+    std::vector<uint64_t> offsets_, strides_;
+    uint64_t bytes_ = 0;
+    int64_t experts_ = 0;
+};
+
+} // namespace strata::kernels::cpu

diff --git a/src/kernels/cpu/iq3s_compact.inl b/src/kernels/cpu/iq3s_compact.inl
new file mode 100644
index 00000000..b66e8917
--- /dev/null
+++ b/src/kernels/cpu/iq3s_compact.inl
@@ -0,0 +1,81 @@
+// Included inside the AVX2 translation unit after its native row helpers.
+namespace iq3s_compact_detail {
+
+template<int NT>
+inline void dot(const Iq3sCompactBlock* row, int nb, const block_q8_K* const* y, float* res) {
+    const __m128i table = _mm_setr_epi8(1,3,5,7,9,11,13,15,-1,-3,-5,-7,-9,-11,-13,-15);
+    const __m128i mask = _mm_set1_epi8(15);
+    __m256 accf[NT];
+    for (int t = 0; t < NT; ++t) accf[t] = _mm256_setzero_ps();
+    const int pf = prefetch_distance();
+    for (int i = 0; i < nb; ++i) {
+        const auto& b = row[i];
+        rows_ahead(reinterpret_cast<const uint8_t*>(&b), pf);
+        __m256i acci[NT];
+        for (int t = 0; t < NT; ++t) acci[t] = _mm256_setzero_si256();
+        for (int h = 0; h < 8; ++h) {
+            const __m128i q = _mm_loadu_si128(reinterpret_cast<const __m128i*>(b.weights + 16*h));
+            const __m128i lo = _mm_shuffle_epi8(table, _mm_and_si128(q, mask));
+            const __m128i hi = _mm_shuffle_epi8(table, _mm_and_si128(_mm_srli_epi16(q, 4), mask));
+            const __m256i signed_g = _mm256_inserti128_si256(_mm256_castsi128_si256(lo), hi, 1);
+            const __m256i g = _mm256_abs_epi8(signed_g);
+            const __m256i sgn = _mm256_sign_epi8(_mm256_set1_epi8(1), signed_g);
+            const int s = b.scales[h];
+            const __m256i sc = sc16(2*(s & 15)+1, 2*(s >> 4)+1);
+            for (int t = 0; t < NT; ++t) {
+                const __m256i yv = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(y[t][i].qs + 32*h));
+                // Sign the activation, including native -128 wrap; do not sign the multiply instead.
+                acci[t] = plain::madd_add(acci[t], _mm256_maddubs_epi16(g, _mm256_sign_epi8(yv, sgn)), sc);
+            }
+        }
+        const float d = h2f(b.d) * Fmt32<21>::K;
+        for (int t = 0; t < NT; ++t)
+            accf[t] = _mm256_fmadd_ps(_mm256_set1_ps(d*y[t][i].d), _mm256_cvtepi32_ps(acci[t]), accf[t]);
+    }
+    for (int t = 0; t < NT; ++t) res[t] = hsum8(accf[t]);
+}
+
+template<int NT>
+void gu(const Iq3sCompactBlock* data, int nb, const void* const* act, float* const* out,
+        int rows, int r0, int r1) {
+    const block_q8_K* y[NT];
+    for (int t = 0; t < NT; ++t) y[t] = reinterpret_cast<const block_q8_K*>(act[t]);
+    float g[NT], u[NT];
+    for (int r = r0; r < r1; ++r) {
+        dot<NT>(data + size_t(r)*nb, nb, y, g);
+        dot<NT>(data + size_t(rows+r)*nb, nb, y, u);
+        for (int t = 0; t < NT; ++t) out[t][r] = (g[t]/(1.f + std::exp(-g[t]))) * u[t];
+    }
+}
+} // namespace iq3s_compact_detail
+
+void iq3s_compact_expand(const uint8_t* src, Iq3sCompactBlock* dst, size_t blocks) {
+    for (size_t i = 0; i < blocks; ++i) {
+        const uint8_t* b = src + i*Fmt32<21>::bytes;
+        dst[i].d = u16(b);
+        for (int j = 0; j < 4; ++j) for (int h = 0; h < 2; ++h) {
+            __m256i g, sign, sc;
+            Fmt32<21>::decode(b, j, h, g, sign, sc);
+            alignas(32) uint8_t codes[32];
+            alignas(32) int16_t scales[16];
+            // Each positive grid is odd in [1,15]. Its three-bit magnitude index plus sign is exact.
+            const __m256i mag = _mm256_and_si256(_mm256_srli_epi16(_mm256_sub_epi8(g,_mm256_set1_epi8(1)),1),_mm256_set1_epi8(7));
+            const __m256i neg = _mm256_and_si256(sign, _mm256_set1_epi8(8));
+            _mm256_store_si256(reinterpret_cast<__m256i*>(codes), _mm256_or_si256(mag,neg));
+            _mm256_store_si256(reinterpret_cast<__m256i*>(scales), sc);
+            const int H = 2*j+h;
+            for (int q = 0; q < 16; ++q) dst[i].weights[16*H+q] = codes[q] | (codes[q+16] << 4);
+            dst[i].scales[H] = uint8_t(((scales[0]-1)/2) | (((scales[8]-1)/2) << 4));
+        }
+    }
+}
+
+void iq3s_compact_gu(const Iq3sCompactBlock* src, int nb, const void* const* act, int nt,
+                     float* const* out, int rows, int r0, int r1) {
+    switch (nt) {
+#define IQ3S_NT(N) case N: iq3s_compact_detail::gu<N>(src,nb,act,out,rows,r0,r1); break
+        IQ3S_NT(1); IQ3S_NT(2); IQ3S_NT(3); IQ3S_NT(4);
+        IQ3S_NT(5); IQ3S_NT(6); IQ3S_NT(7); IQ3S_NT(8);
+#undef IQ3S_NT
+    }
+}
